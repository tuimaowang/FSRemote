        <!-- =====wjy==== -->
        <file alias="resource/images/menu/power_on.svg">uuguest/menu/power_on.svg</file> <!-- wjy: 开机菜单使用绿色启动图标，不再和关机共用 power.svg。 -->
        <file alias="resource/images/menu/shutdown.svg">uuguest/menu/shutdown.svg</file> <!-- wjy: 关机菜单使用红色关闭图标。 -->
        <file alias="resource/images/menu/update.svg">uuguest/menu/update.svg</file> <!-- wjy: 注册真实存在的菜单更新图标，修复原 refresh.svg 路径为空。 -->
