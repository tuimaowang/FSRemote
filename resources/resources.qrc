        <file alias="resource/images/titlebar/chevron_down.svg">uuguest/titlebar/chevron_down.svg</file>
        <file alias="resource/images/titlebar/device_group.svg">uuguest/titlebar/device_group.svg</file>
        <file alias="resource/images/titlebar/remote_assist_group.svg">uuguest/titlebar/remote_assist_group.svg</file>
