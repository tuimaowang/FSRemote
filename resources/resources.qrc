        <file alias="resource/images/titlebar/controlled_notice.svg">uuguest/titlebar/controlled_notice.svg</file>
        <file alias="resource/images/titlebar/remote_badge.svg">uuguest/titlebar/remote_badge.svg</file>
        <file alias="resource/images/titlebar/file_transfer.svg">uuguest/titlebar/file_transfer.svg</file>
        <file alias="resource/images/titlebar/more.svg">uuguest/titlebar/more.svg</file>
        <file alias="resource/images/titlebar/device_status_offline.svg">uuguest/titlebar/device_status_offline.svg</file>
        <file alias="resource/images/titlebar/device_status_busy.svg">uuguest/titlebar/device_status_busy.svg</file>
        <file alias="resource/images/titlebar/refresh.svg">uuguest/titlebar/refresh.svg</file>
        <file alias="resource/images/titlebar/wake_power.svg">uuguest/titlebar/wake_power.svg</file>
        <file alias="resource/images/titlebar/wake_loading_bg.png">uuguest/titlebar/wake_loading_bg.png</file>
        <file alias="resource/images/titlebar/wake_loading_spinner.png">uuguest/titlebar/wake_loading_spinner.png</file>
